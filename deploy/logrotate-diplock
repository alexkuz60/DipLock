# Ротация логов DipLock. Копия: sudo cp deploy/logrotate-diplock /etc/logrotate.d/diplock
# server.log держит uvicorn открытым: copytruncate вместо create (переоткрытия нет).
# data/cache/journal.jsonl режет сам сервис (JOURNAL_MAX_BYTES) — здесь его нет.
/srv/diplock/repo/data/logs/*.log {
    weekly
    size 100M
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su ubuntu ubuntu
}
