@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix vamp:     <http://purl.org/ontology/vamp/> .
@prefix :         <#> .

# Трансформ Chordino (NNLS Chroma, M. Mauch), вывод «Chord Estimate»
# (vamp:nnls-chroma:chordino:simplechord) — карта аккордов рендера
# «Нейромузыки» (мастер 48 кГц). Ловушка hop (21.10.2026): step 0.1 с
# (4800 сэмплов) — при step 0.2 с HMM-сглаживание плагина «съедает» смены
# аккордов (C+Am сливаются в один сегмент). Block 24576 = 0.512 с окна
# (пропорционально 16384/32000 моно-файла «ЕмоЛаб»). Параметры плагина —
# дефолты MIREX (useNNLS=1, useHMM=1, boostn=0.1): точные имена аккордов
# («G7», «Ebm6», «Gaug») уходят в контракт как есть, «N» (нет аккорда)
# отбрасывается парсером.
:transform a vamp:Transform ;
    vamp:plugin <http://vamp-plugins.org/rdf/plugins/nnls-chroma#chordino> ;
    vamp:sample_rate "48000"^^xsd:float ;
    vamp:step_size "4800"^^xsd:int ;
    vamp:block_size "24576"^^xsd:int ;
    vamp:plugin_version """""" ;
    vamp:output <http://vamp-plugins.org/rdf/plugins/nnls-chroma#chordino_output_simplechord> .