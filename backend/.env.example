# DipLock — пример конфигурации окружения
# Скопируйте: cp .env.example .env
# Затем отредактируйте пути под вашу машину

# База данных (SQLite для локальной разработки, PostgreSQL в Docker)
DATABASE_URL=sqlite+aiosqlite:///./diplock.db

# Путь к FSAverage данным MNE-Python
# Скачать один раз: python -c "import mne; mne.datasets.fsaverage.data_path(download=True)"
SUBJECTS_DIR=/home/alexkuz60/mne_data/MNE-fsaverage-data
FSAVERAGE_TRANS=/home/alexkuz60/mne_data/MNE-fsaverage-data/fsaverage/bem/fsaverage-trans.fif

# Папки для загрузки EDF и результатов анализа
UPLOAD_DIR=./data/edf
RESULTS_DIR=./data/results

# Единицы EDF (опционально). Если не задано — MNE автоопределяет, а при
# нефизиологичном масштабе (файл без physical dimension) значения трактуются
# как микровольты. Задайте явно (V/mV/uV), если авто-детект ошибается.
# EDF_UNITS=uV

# Дипольный фитинг: прореживание evoked по времени (1 = без прореживания)
DIPOLE_FIT_DECIM=5
# Максимум эпох для фитинга (0 = все; ограничивает время ответа API)
DIPOLE_FIT_MAX_EPOCHS=0

# Порог reject при нарезке эпох, мкВ (эпохи выше порога отбрасываются)
REJECT_THRESHOLD_UV=150

# Кэш тяжёлых статических ассетов (меш fsaverage, атлас Brodmann, пирамида сигналов)
CACHE_DIR=/home/alexkuz60/DipLock/data/cache

# Пирамида сигналов вьюера треков: уровни зума и бюджет точек на канал на ×1
# (уровень ×k отдаёт не больше SIGNAL_BASE_POINTS*k точек, поэтому размер ответа
# не зависит от длины записи). Список уровней — через запятую; меняйте уровни
# только вместе с бюджетом: UI берёт список из /meta.
SIGNAL_LEVELS=1,2,4,8,16
SIGNAL_BASE_POINTS=4000

# CORS: origins, которым разрешён доступ к API (5173 — Vite dev-server).
# При работе через Vite proxy CORS не используется, но порт разрешён и напрямую.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Фоновые задачи: сколько анализов считать одновременно и сколько хранить в истории
MAX_CONCURRENT_JOBS=2
JOBS_HISTORY_LIMIT=50

# Загруженные для просмотра записи: сколько держать на диске и сколько часов
# (устаревшие каталоги data/edf/<recording_id> удаляются при обращении к реестру)
RECORDINGS_HISTORY_LIMIT=10
RECORDINGS_TTL_HOURS=24

# Кэш подготовленного сигнала: сколько наборов «запись + полоса + notch + референс»
# держать в RAM (0 — выключен, каждый расчёт читает EDF заново). Один набор —
# float64-данные записи: 130 с × 500 Гц × 18 каналов ≈ 9.4 МБ.
PREPARED_SIGNAL_CACHE_SIZE=2

# Журнал шагов (диагностика времени): JSONL-файл пошаговых замеров рядом с кэшем
# (CACHE_DIR/journal.jsonl), читается GET /api/v1/journal. Запись можно выключить
# (JOURNAL_ENABLED=false) — журнал ничего не отдаёт в расчёт, он только измеряет.
# JOURNAL_MAX_BYTES — предел размера файла перед ротацией: полное поколение уезжает
# в journal.jsonl.1, поэтому на диске всегда не больше двух файлов.
JOURNAL_ENABLED=true
JOURNAL_MAX_BYTES=5000000
